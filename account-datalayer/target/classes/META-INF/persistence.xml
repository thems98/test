<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="accountPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>

        <class>se.liu.ida.tdp024.account.data.impl.db.entity.AccountDB</class>
        <class>se.liu.ida.tdp024.account.data.impl.db.entity.TransactionDB</class>

        <properties>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:derby:memory:accountDB;create=true"/>
            <property name="jakarta.persistence.jdbc.driver"
                      value="org.apache.derby.jdbc.EmbeddedDriver"/>
            <property name="eclipselink.ddl-generation"
                      value="create-or-extend-tables"/>
            <property name="eclipselink.logging.level" value="FINE"/>
        </properties>
    </persistence-unit>
</persistence>